source "https://rubygems.org"

# Match GitHub Pages' Jekyll environment as closely as possible.
gem "github-pages", group: :jekyll_plugins

# Required for Ruby 3+ local serving (Jekyll uses it for the dev server).
gem "webrick", "~> 1.8"

# Ruby 3.4+/4.x: csv is no longer a default gem, but Jekyll requires it.
gem "csv"

# Ruby 3.4+/4.x: required by Liquid/Jekyll filters.
gem "bigdecimal"
